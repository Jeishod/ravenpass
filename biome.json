{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "root": true,
  "files": {
    "includes": ["packages/ui/**", "apps/extension/**"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useImportExtensions": "error"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
